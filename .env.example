# OpenAI API key — get yours at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...your-key-here...

# (Optional) Model to use — gpt-4o recommended for best website quality
# OPENAI_MODEL=gpt-4o

# (Optional) Where to save generated websites
# OUTPUT_DIR=output

# (Optional) Port for the preview server
# PREVIEW_PORT=8000
